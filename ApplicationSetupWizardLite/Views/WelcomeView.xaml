<UserControl x:Class="ApplicationSetupWizardLite.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ApplicationSetupWizardLite.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- タイトル -->
        <Border Grid.Row="0"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1">

            <TextBlock Text="MY APPLICATION セットアップ"
                            VerticalAlignment="Center"
                            Margin="35,0"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="#333333"/>

        </Border>


        <!-- コンテンツ -->
        <Grid Grid.Row="1"
                    Margin="35">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- 説明 -->
            <TextBlock Grid.Row="0"
                            Text="セットアップウィザードへようこそ"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#333333"
                            Margin="0,0,0,25"/>


            <!-- 内容 -->
            <StackPanel Grid.Row="1">

                <TextBlock Text="MY APPLICATION をコンピューターにインストールします。"
                                FontSize="14"
                                Foreground="#444444"
                                TextWrapping="Wrap"/>

                <TextBlock Text="続行するには「次へ」をクリックしてください。"
                                FontSize="14"
                                Foreground="#444444"
                                Margin="0,15,0,0"/>

                <Border Margin="0,40,0,0"
                            Padding="15"
                            Background="#F5F7F8"
                            BorderBrush="#DDDDDD"
                            BorderThickness="1">

                    <StackPanel>

                        <TextBlock Text="インストール内容"
                                        FontWeight="SemiBold"
                                        FontSize="14"/>

                        <TextBlock Text="・アプリケーション本体"
                                        Margin="0,10,0,0"/>

                        <TextBlock Text="・設定ファイル"
                                        Margin="0,5,0,0"/>

                        <TextBlock Text="・必要なライブラリ"
                                        Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
