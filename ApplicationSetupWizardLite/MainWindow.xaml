<Window x:Class="ApplicationSetupWizardLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="セットアップ"
        Width="900"
        Height="560"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>

        <!-- ボタン -->
        <Style x:Key="WizardButtonStyle"
               TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <!-- 左側のステップ -->
        <Style x:Key="StepTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- ========================= -->
        <!-- メイン領域 -->
        <!-- ========================= -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========================= -->
            <!-- 左側 -->
            <!-- ========================= -->
            <Border Grid.Column="0"
                    Background="#263238">

                <Grid Margin="25">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 製品名 -->
                    <StackPanel Grid.Row="0">

                        <TextBlock x:Name="AppNameLbl1"
                                   Text="MY APPLICATION"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                        <TextBlock Text="セットアップ"
                                   Foreground="#B0BEC5"
                                   FontSize="13"
                                   Margin="0,5,0,0"/>

                    </StackPanel>


                    <!-- ステップ -->
                    <StackPanel Grid.Row="1"
                                Margin="0,50,0,0">

                        <TextBlock Text="●  ようこそ"
                                   Style="{StaticResource StepTextStyle}"/>

                        <TextBlock Text="○  インストール先"
                                   Style="{StaticResource StepTextStyle}"/>

                        <TextBlock Text="○  確認"
                                   Style="{StaticResource StepTextStyle}"/>

                        <TextBlock Text="○  インストール"
                                   Style="{StaticResource StepTextStyle}"/>

                        <TextBlock Text="○  完了"
                                   Style="{StaticResource StepTextStyle}"/>

                    </StackPanel>


                    <!-- バージョン -->
                    <TextBlock x:Name="Version" Grid.Row="2"
                               Text="Version 1.0.0"
                               Foreground="#90A4AE"
                               FontSize="11"/>

                </Grid>

            </Border>


            <!-- ========================= -->
            <!-- 右側コンテンツ -->
            <!-- ========================= -->
            <ContentControl x:Name="ContentArea"
                            Grid.Column="1"
                            Background="White">
            </ContentControl>

        </Grid>


        <!-- ========================= -->
        <!-- 下部ボタン -->
        <!-- ========================= -->
        <Border Grid.Row="1"
                Background="#F2F2F2"
                BorderBrush="#D0D0D0"
                BorderThickness="0,1,0,0">

            <Grid Margin="20,0">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button Content="戻る"
                            Style="{StaticResource WizardButtonStyle}"
                            IsEnabled="False"/>

                    <Button Content="次へ ＞"
                            Style="{StaticResource WizardButtonStyle}"/>

                    <Button Content="キャンセル"
                            Style="{StaticResource WizardButtonStyle}"
                            Margin="20,0,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>